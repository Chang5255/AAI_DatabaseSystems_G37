# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB (database/mongodb)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=movie_app

# MySQL application account (database/mysql, webapp, benchmark)
# This account is created by 01b_create_user.sql with the password you
# put here. It can read all of moviedb but may only write users and
# ratings: no DDL, and no writes to the catalogue or the audit table.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=inf2003
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=moviedb

# The other two accounts 01b_create_user.sql creates. Both default to
# MYSQL_PASSWORD when left blank, which is fine for a local demo;
# set them to show that the accounts really are separate.
#   inf2003_report  SELECT on the six views only (not the base tables)
#   inf2003_bench   owns the moviedb_bench scratch database
# MYSQL_REPORT_PASSWORD=
# MYSQL_BENCH_PASSWORD=

# The benchmarks connect as the account below, not as the application
# account. benchmark/mysql_bench.py task T4 renames a person to measure
# the cost of that update, and the application account is correctly
# refused (error 1142: the catalogue is not the app's to edit).
# Leave MYSQL_BENCH_PASSWORD blank above and it falls back to
# MYSQL_PASSWORD, which is what setup_all.py created the account with.
MYSQL_BENCH_USER=inf2003_bench

# Only used by setup_all.py, to run the scripts that need an admin
# account (CREATE DATABASE, CREATE USER, CREATE TRIGGER). Leave it
# blank and the script asks for the password instead of storing it.
# MYSQL_ROOT_USER=root
# MYSQL_ROOT_PASSWORD=

# Movie posters (optional): only needed to refresh data/cleaned/posters.csv with
# database/mongodb/fetch_posters.py. TMDB API key or read access token from
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Web UI (optional): keeps the selected user across restarts
# FLASK_SECRET_KEY=any-long-random-text
